{
  "name": "TrendSellr API (OpenJDK Community Build)",
  "image": "eclipse-temurin:21-jdk-jammy",
  "features": {
    "ghcr.io/devcontainers/features/maven:1": {
        "version": "3.9"
    }
  },

  // 3. EL RESTO DE LA CONFIGURACIÓN:
  // Esto se mantiene exactamente igual que antes.
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "k--kato.intellij-idea-keybindings",
        "mongodb.mongodb-vscode",
        "esbenp.prettier-vscode",
        "humao.rest-client"
      ]
    }
  },
  "forwardPorts": [8080],
  "postCreateCommand": "mvn clean install -DskipTests"
}
