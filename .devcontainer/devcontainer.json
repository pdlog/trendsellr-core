{
  "name": "TrendSellr API (OpenJDK Community Build)",
  "image": "maven:3.9.5-eclipse-temurin-21-jammy",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "k--kato.intellij-idea-keybindings",
        "mongodb.mongodb-vscode",
        "esbenp.prettier-vscode",
        "humao.rest-client"
